# VelocityX read-only Binance market/account dashboard
# Copy to .env and set credentials only for accounts you want to inspect.
# The current build has no order-writing or position-management functionality.

PORT=4000
VX_HOST=0.0.0.0
# VX_DATA_DIR=/var/lib/velocityx

# Optional dashboard token; protects /api (except /api/health) and /ws.
# VX_API_TOKEN=change-me-long-random-string

# testnet selects Binance Demo account data; live selects real-account data.
# Public market data always comes from Binance mainnet.
BINANCE_MODE=testnet
BINANCE_SYMBOL=BTCUSDT

# Account-read credentials. Use read-only permissions and IP restrictions.
# BINANCE_TESTNET_KEY=
# BINANCE_TESTNET_SECRET=
# BINANCE_LIVE_KEY=
# BINANCE_LIVE_SECRET=

# Optional Binance Demo endpoint overrides.
# BINANCE_TESTNET_REST=https://demo-fapi.binance.com
# BINANCE_TESTNET_WS=wss://demo-fstream.binance.com
