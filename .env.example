# ---------------------------------------------------------------------------
# VelocityX — environment template. Copy to `.env` (never commit the real one).
# Dashboard settings override these values; the file below is the minimum an
# operator needs to run the bot in production. There is NO simulation mode:
# orders always go to Binance (testnet or live mainnet).
# ---------------------------------------------------------------------------

# ---- server -----------------------------------------------------------------
PORT=4000
# Bind address. 0.0.0.0 is required inside containers / hosted previews.
VX_HOST=0.0.0.0
# Journal + settings directory (defaults to server/data).
# VX_DATA_DIR=/var/lib/velocityx

# ---- access control (strongly recommended) ---------------------------------
# When set, every /api route (except /api/health) and the /ws socket require
# this token. Enter the same value in the dashboard: Settings → Connection.
# VX_API_TOKEN=change-me-long-random-string

# ---- trading ----------------------------------------------------------------
# testnet | live   (paper/simulation was removed — the bot only trades for real)
BINANCE_MODE=live

# Auto-trading on a persisted LIVE config is NOT resumed by a restart unless
# this flag is set. Without it the server boots LIVE but DISARMED.
# VX_ALLOW_LIVE=1

# API keys (optional — they can also be entered in the dashboard, which stores
# them in server/data/settings.json with 0600 permissions).
# BINANCE_TESTNET_KEY=
# BINANCE_TESTNET_SECRET=
# BINANCE_LIVE_KEY=
# BINANCE_LIVE_SECRET=

# Primary symbol used for the dashboard/topbar when the scanner drives trading.
BINANCE_SYMBOL=BTCUSDT
